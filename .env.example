# Sabora production-candidate configuration names only.
# Copying this file is not an activation procedure. Every __...__ marker must
# be replaced by the authorized runtime injector; validators reject markers.
NODE_ENV=production
SABORA_API_HOST=0.0.0.0
SABORA_API_PORT=4100
SABORA_API_MODE=health-only

# Public build-time installation identifier. It is not a credential.
VITE_SABORA_RESTAURANT_CODE=__INSTALLATION_CODE__

# Dormant, component-specific PostgreSQL identities. The active health-only
# process rejects these values and does not need them.
SABORA_STAFF_DB_HOST=__INJECT_HOST_AT_RUNTIME__
SABORA_STAFF_DB_PORT=5432
SABORA_STAFF_DB_NAME=__INJECT_DATABASE_AT_RUNTIME__
SABORA_STAFF_DB_USER=sabora_staff_reader_login
SABORA_STAFF_DB_PASSWORD=__INJECT_SECRET_AT_RUNTIME__
SABORA_STAFF_DB_CA_PEM=__INJECT_PEM_AT_RUNTIME__

SABORA_CATALOG_DB_HOST=__INJECT_HOST_AT_RUNTIME__
SABORA_CATALOG_DB_PORT=5432
SABORA_CATALOG_DB_NAME=__INJECT_DATABASE_AT_RUNTIME__
SABORA_CATALOG_DB_USER=sabora_catalog_login
SABORA_CATALOG_DB_PASSWORD=__INJECT_SECRET_AT_RUNTIME__
SABORA_CATALOG_DB_CA_PEM=__INJECT_PEM_AT_RUNTIME__

SABORA_CUSTOMER_SESSION_DB_HOST=__INJECT_HOST_AT_RUNTIME__
SABORA_CUSTOMER_SESSION_DB_PORT=5432
SABORA_CUSTOMER_SESSION_DB_NAME=__INJECT_DATABASE_AT_RUNTIME__
SABORA_CUSTOMER_SESSION_DB_USER=sabora_customer_session_login
SABORA_CUSTOMER_SESSION_DB_PASSWORD=__INJECT_SECRET_AT_RUNTIME__
SABORA_CUSTOMER_SESSION_DB_CA_PEM=__INJECT_PEM_AT_RUNTIME__
