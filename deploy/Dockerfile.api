FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/client/package.json apps/client/package.json
COPY apps/management/package.json apps/management/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --filter @sabora/api...
COPY apps/api/src ./apps/api/src
RUN pnpm --filter @sabora/api build && pnpm --filter @sabora/api deploy --legacy --prod /out

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
# Fixed nonroot service identities; no host account is created by this image.
RUN addgroup -S -g 10002 sabora && adduser -S -u 10002 -G sabora sabora && \
    addgroup -S -g 10003 sabora-egress && adduser -S -u 10003 -G sabora-egress sabora-egress
COPY --from=build --chown=sabora:sabora /out/ ./
# Both nonroot identities may read the application code, never host secrets.
RUN chmod -R a+rX /app
USER sabora
EXPOSE 4100
CMD ["node", "src/server.mjs"]
