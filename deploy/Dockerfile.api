FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/client/package.json apps/client/package.json
COPY apps/management/package.json apps/management/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --filter @sabora/api...
COPY apps/api/src ./apps/api/src
RUN pnpm --filter @sabora/api build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S sabora && adduser -S -G sabora sabora
COPY --from=build --chown=sabora:sabora /workspace/apps/api /app/apps/api
COPY --from=build --chown=sabora:sabora /workspace/node_modules /app/node_modules
USER sabora
EXPOSE 4100
CMD ["node", "apps/api/src/server.mjs"]
