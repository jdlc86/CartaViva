# Two separate HTTPS origins; no automatic ACME, shared host proxy or Fleetia dependency.
# Certificates and hostnames are supplied ONLY by the authorized Sabora operator.
{
 admin off
 auto_https off
}

https://{$SABORA_CLIENT_HOST}:8443 {
 tls /run/sabora/tls/client.crt /run/sabora/tls/client.key
 encode gzip
 header {
  X-Content-Type-Options "nosniff"
  Referrer-Policy "no-referrer"
  X-Frame-Options "DENY"
  Strict-Transport-Security "max-age=31536000"
  Cache-Control "no-store"
 }
 @api path /api /api/*
 handle @api {
  reverse_proxy api:4100
 }
 handle {
  root * /srv/sabora/client
  try_files {path} /index.html
  file_server
 }
}

https://{$SABORA_MANAGEMENT_HOST}:8443 {
 tls /run/sabora/tls/management.crt /run/sabora/tls/management.key
 encode gzip
 header {
  X-Content-Type-Options "nosniff"
  Referrer-Policy "no-referrer"
  X-Frame-Options "DENY"
  Strict-Transport-Security "max-age=31536000"
  Cache-Control "no-store"
 }
 @api path /api /api/*
 handle @api {
  reverse_proxy api:4100
 }
 handle {
  root * /srv/sabora/management
  try_files {path} /index.html
  file_server
 }
}
